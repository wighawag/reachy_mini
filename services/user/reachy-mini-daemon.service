#~/.config/systemd/user/reachy-mini-daemon.service
[Unit]
Description=Reachy Mini Daemon
# network is still fine; audio must start first
After=network.target pulseaudio.service
Wants=pulseaudio.service

[Service]
Type=simple
WorkingDirectory=%h/dev/github.com/pollen-robotics/reachy_mini
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/uv run reachy-mini-daemon
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reachy-mini-daemon

[Install]
WantedBy=default.target